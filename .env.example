# Copiar a infra/.env en el servidor y completar. NUNCA subir el archivo real.

# Dominio público de los tableros
DOMAIN=tableros.scitech.com.co

# Login con Google (oauth2-proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generar con: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
ALLOWED_EMAIL_DOMAIN=scitech.com.co

# Jira: una cuenta de servicio de SOLO LECTURA por sitio
JIRA_SCITECH_URL=https://scitech.atlassian.net
JIRA_SCITECH_EMAIL=
JIRA_SCITECH_TOKEN=

JIRA_SALUD360_URL=https://salud360.atlassian.net
JIRA_SALUD360_EMAIL=
JIRA_SALUD360_TOKEN=

# Caché de consultas a Jira (segundos)
CACHE_TTL_SECONDS=600
